# Team HQ — environment configuration
# Copy this file to `.env` and fill in your Supabase project values.
# NEVER commit your real `.env` file.

# Supabase project URL — e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe to expose in a static site
VITE_SUPABASE_ANON_KEY=
